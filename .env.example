# Pi Voice AI — Çevre Değişkenleri Şablonu
# Bu dosyayı `.env` olarak kopyala ve gerçek anahtarları gir.
# `.env` Git'e GİRMEZ (.gitignore'da listeli).

# Anthropic Claude API
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API (Whisper STT + TTS için)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Opsiyonel: Loglama seviyesi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
